{
  "name": "magic-store",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 5441",
    "images": "node scripts/prepare-images.mjs && node scripts/cutout.mjs && node scripts/prepare-video.mjs",
    "build": "astro build",
    "preview": "node scripts/serve-dist.mjs",
    "brand": "node scripts/brand-assets.mjs",
    "font": "node scripts/subset-font.mjs",
    "check": "astro check && astro build && node scripts/check-links.mjs",
    "shopify": "node scripts/shopify-export.mjs",
    "theme": "node scripts/build-theme.mjs",
    "theme:check": "npx --yes @shopify/cli@latest theme check --path shopify-theme"
  },
  "dependencies": {
    "astro": "^7.3.5",
    "lenis": "^1.3.26",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "fontkit": "^2.0.4",
    "opentype.js": "^2.0.0",
    "subset-font": "^2.9.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
