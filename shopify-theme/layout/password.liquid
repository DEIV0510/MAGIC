<!doctype html>
<html lang="{{ request.locale.iso_code | default: 'es' }}" data-page="page">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#0d0d0d">
    <title>MAGIC WORLD · Pronto</title>
    <link rel="icon" href="{{ 'mw-favicon.svg' | asset_url }}" type="image/svg+xml">
    <style>
      @font-face {
        font-family: 'Mona Sans';
        src: url('{{ 'mona-sans.woff2' | asset_url }}') format('woff2');
        font-weight: 400 800;
        font-stretch: 75% 125%;
        font-display: swap;
      }
    </style>
    {{ 'magic.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body data-tone="dark">
    {%- render 'mw-wordmark-sprite' -%}
    <main id="main">{{ content_for_layout }}</main>
  </body>
</html>
