<section class="page password" aria-labelledby="page-title">
  <div class="password__mark">{% render 'mw-wordmark', wm_layout: 'stack', label: 'MAGIC WORLD' %}</div>
  <h1 class="page__title t-display" id="page-title">{{ section.settings.title }}</h1>
  {%- if shop.password_message != blank -%}
    <p class="t-lead">{{ shop.password_message }}</p>
  {%- endif -%}
  {%- form 'storefront_password', class: 'password__form' -%}
    {%- if form.errors -%}<p class="opt__error" role="alert">La contraseña no es correcta.</p>{%- endif -%}
    <div class="field">
      <label for="pw">Contraseña de la tienda</label>
      <input id="pw" type="password" name="password" autocomplete="current-password" required>
    </div>
    <button class="btn btn--red" type="submit"><span class="roll"><span>Entrar</span><span aria-hidden="true">Entrar</span></span></button>
  {%- endform -%}
</section>

{% schema %}
{
  "name": "Contraseña",
  "settings": [{ "type": "text", "id": "title", "label": "Título", "default": "Muy pronto" }]
}
{% endschema %}
