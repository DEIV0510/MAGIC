---
import '@/styles/shop.css';
import fs from 'node:fs';
import Base from '@/layouts/Base.astro';
import Img from '@/components/Img.astro';
import Icon from '@/components/Icon.astro';
import ProductCard from '@/components/ProductCard.astro';
import ProductVideo from '@/components/ProductVideo.astro';
import {
  products,
  collections,
  altFor,
  fabricLine,
  formatPrice,
  pad2,
  productTag,
  sizesLabel,
  swatchStyle,
  type Product,
} from '@/data/products';
import { site } from '@/data/site';
import { getMedia } from '@/lib/media';
import { productMessage, waLink } from '@/lib/whatsapp';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}

interface Props {
  product: Product;
}
const { product: p } = Astro.props;
const c0 = p.colors[0];
const crumb = collections.find((c) => c.slug === p.gender)!;

// Relacionados: primero el mismo género y la misma categoría.
const related = products
  .filter((x) => x.slug !== p.slug)
  .sort(
    (a, b) =>
      Number(b.gender === p.gender) - Number(a.gender === p.gender) ||
      Number(b.categories[0] === p.categories[0]) - Number(a.categories[0] === p.categories[0]) ||
      (a.priority ?? 99) - (b.priority ?? 99),
  )
  .slice(0, 3);

const colorsText = p.colors.map((c) => c.label.toLowerCase()).join(', ').replace(/, ([^,]*)$/, ' y $1');
const description = p.price
  ? `${p.name} de ${site.name}: ${formatPrice(p.price)} con envío incluido. ${p.summary} En ${colorsText}${p.sizes ? `, tallas ${p.sizes.join(', ')}` : ''}.`
  : `${p.name} de ${site.name} en ${colorsText}. ${p.summary} Pide precio y tallas por WhatsApp.`;
const ogPath = `/og/og-${p.slug}.jpg`;
const ogImage = fs.existsSync(`public${ogPath}`) ? ogPath : '/og/og-home.jpg';

const siteUrl = Astro.site;
const abs = (path: string) => (siteUrl ? new URL(path, siteUrl).href : path);
const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.name,
  description: p.description,
  brand: { '@type': 'Brand', name: site.name },
  category: p.type,
  sku: `MW-${p.code}`,
  ...(p.material ? { material: p.material } : {}),
  color: p.colors.map((c) => c.label).join(', '),
  ...(p.sizes ? { size: p.sizes.join(', ') } : {}),
  image: p.colors.flatMap((c) => c.images.map((i) => abs(getMedia(i.id).fallback))),
  url: abs(`/producto/${p.slug}/`),
  ...(p.price
    ? {
        offers: {
          '@type': 'Offer',
          price: p.price,
          priceCurrency: site.currency,
          availability: 'https://schema.org/InStock',
          itemCondition: 'https://schema.org/NewCondition',
          url: abs(`/producto/${p.slug}/`),
        },
      }
    : {}),
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: abs('/') },
    { '@type': 'ListItem', position: 2, name: crumb.title, item: abs(crumb.path) },
    { '@type': 'ListItem', position: 3, name: p.name, item: abs(`/producto/${p.slug}/`) },
  ],
};
const wa = (label: string) => waLink(productMessage(p.name, label, p.price));
const fabric = fabricLine(p);
---

<Base
  title={`${p.name} · ${site.name}`}
  description={description}
  image={ogImage}
  imageAlt={p.name}
  type="product"
  page="product"
  jsonLd={[productLd, breadcrumbLd]}
>
  <link slot="head" rel="expect" href="#vt-target" blocking="render" />

  <article class="pdp" data-pdp data-slug={p.slug}>
    <div class="pdp__gallery">
      {
        p.colors.map((c, ci) => (
          <div class:list={['pdp__set', { 'is-active': ci === 0 }]} data-set={c.id} role="region" tabindex="0" aria-label={`Fotos en color ${c.label.toLowerCase()}`}>
            {c.images.map((img, ii) => {
              const first = ci === 0 && ii === 0;
              return (
                <>
                  <figure class="pdp__shot frame">
                    <Img
                      id={img.id}
                      alt={altFor(p, c, img)}
                      sizes="(min-width: 1024px) 29vw, 100vw"
                      priority={first}
                      loading={ci === 0 ? 'eager' : 'lazy'}
                      domId={first ? 'vt-target' : undefined}
                      draggable="false"
                    />
                  </figure>
                  {ii === 0 && p.video?.color === c.id && (
                    <div class="pdp__shot pdp__shot--video">
                      <ProductVideo label={`${p.name} en color ${c.label.toLowerCase()}: video real de la tela`} />
                    </div>
                  )}
                </>
              );
            })}
          </div>
        ))
      }
      <p class="pdp__count" aria-hidden="true" data-count></p>
    </div>

    <div class="pdp__info">
      <nav class="crumbs" aria-label="Ruta de navegación">
        <ol>
          <li><a href="/">Inicio</a></li>
          <li><a href={crumb.path}>{crumb.title}</a></li>
          <li aria-current="page">{p.name}</li>
        </ol>
      </nav>

      <div class="pdp__head">
        <div class="pdp__idx">
          <span class="t-index">{p.priority ? pad2(p.priority) : '—'}</span>
          <span class="t-label t-mute">{productTag(p)}</span>
        </div>
        <h1 class="pdp__name t-display">{p.name}</h1>
        <p class="pdp__price">
          {p.price ? formatPrice(p.price) : 'Precio por WhatsApp'}
          <small>{p.price ? 'Envío incluido' : 'Te lo confirmamos junto con la talla.'}</small>
        </p>
        <p class="pdp__summary">{p.description}</p>
      </div>

      <form class="pdp__form" data-pdp-form novalidate>
        <fieldset class="opt">
          <legend class="opt__legend">Color: <strong data-color-name>{c0.label}</strong></legend>
          <div class="opt__row">
            {
              p.colors.map((c, i) => (
                <label class="opt__item opt__item--color">
                  <input class="sr-only" type="radio" name="color" value={c.id} checked={i === 0} data-label={c.label} data-wa={wa(c.label)} />
                  <span class="opt__swatch" style={swatchStyle(c)} aria-hidden="true" />
                  <span>{c.label}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <fieldset class="opt" data-size-field>
          <legend class="opt__legend">Talla</legend>
          {
            p.sizes ? (
              <>
                <div class="opt__row">
                  {p.sizes.map((z) => (
                    <label class="opt__item opt__item--size">
                      <input class="sr-only" type="radio" name="size" value={z} />
                      <span>{z}</span>
                    </label>
                  ))}
                </div>
                <p class="opt__error" data-size-error role="alert" hidden>
                  Elige una talla.
                </p>
              </>
            ) : (
              <p class="pdp__note">Te asesoramos con la talla por WhatsApp.</p>
            )
          }
        </fieldset>

        <div class="pdp__ctas" data-main-cta>
          <button class="btn btn--block" type="submit" data-pdp-buy>
            <span class="roll"><span>Comprar ahora</span><span aria-hidden="true">Comprar ahora</span></span>
          </button>
          <button class="btn btn--ghost btn--block" type="button" data-pdp-add>
            <span class="roll"><span>Agregar a la bolsa</span><span aria-hidden="true">Agregar a la bolsa</span></span>
          </button>
          <a class="link" href={wa(c0.label)} target="_blank" rel="noopener" data-wa-product style="justify-self:start">
            <Icon name="whatsapp" />
            ¿Dudas? Escríbenos por WhatsApp
          </a>
        </div>
      </form>

      <div class="pdp__details">
        <details open>
          <summary>Detalles <Icon name="plus" /></summary>
          <div class="body">
            <ul>{p.details.map((d) => <li>{d}</li>)}</ul>
          </div>
        </details>
        {
          fabric && (
            <details>
              <summary>
                Tela <Icon name="plus" />
              </summary>
              <div class="body">
                <p>{fabric}.</p>
              </div>
            </details>
          )
        }
        <details>
          <summary>Envío y pedidos <Icon name="plus" /></summary>
          <div class="body">
            <p>
              {p.price ? 'El precio incluye el envío. ' : ''}Haces el pedido por WhatsApp y te confirmamos talla y disponibilidad
              antes del pago.{sizesLabel(p) ? ` Tallas: ${sizesLabel(p)}.` : ''}
            </p>
          </div>
        </details>
      </div>
    </div>
  </article>

  <section class="related" aria-labelledby="related-title">
    <div class="related__head">
      <h2 class="related__title t-display" id="related-title">También<br />en MAGIC WORLD</h2>
      <a class="link" href="/coleccion/">Ver colección <Icon name="arrow" /></a>
    </div>
    <div class="related__row">
      {related.map((r) => <ProductCard product={r} size="sm" sizes="(min-width: 1024px) 31vw, 76vw" reveal={false} eager />)}
    </div>
  </section>

  <div class="buybar" data-buybar>
    <p class="buybar__name">
      {p.name}
      <small><span data-buybar-color>{c0.label}</span>{p.price ? ` · ${formatPrice(p.price)}` : ''}</small>
    </p>
    <button class="btn" type="button" data-pdp-buybar>
      <span class="roll"><span>Comprar</span><span aria-hidden="true">Comprar</span></span>
    </button>
    <a class="btn btn--ghost btn--icon" href={wa(c0.label)} target="_blank" rel="noopener" aria-label={`Pedir ${p.name} por WhatsApp`} data-wa-product>
      <Icon name="whatsapp" />
    </a>
  </div>
</Base>
