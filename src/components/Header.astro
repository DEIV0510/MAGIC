---
import { nav } from '@/data/site';
import Wordmark from './Wordmark.astro';
import Icon from './Icon.astro';

interface Props {
  /** 'clear' = transparente sobre la portada; se vuelve papel al bajar. */
  surface?: 'clear' | 'paper';
}
const { surface = 'paper' } = Astro.props;
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : !href.includes('#') && path.startsWith(href));
---

<header class="hdr" data-surface={surface} data-initial={surface}>
  <div class="hdr__bar">
    <nav class="hdr__nav" aria-label="Principal">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="hdr__logo" href="/" aria-label="MAGIC WORLD, ir al inicio">
      <Wordmark />
    </a>

    <div class="hdr__actions">
      <button class="hdr__btn" type="button" data-open="search" aria-haspopup="dialog" aria-controls="search" aria-label="Buscar">
        <Icon name="search" />
        <span class="hdr__txt" aria-hidden="true">Buscar</span>
      </button>
      <button class="hdr__btn" type="button" data-open="bag" aria-haspopup="dialog" aria-controls="bag" aria-label="Bolsa, vacía" data-bag-button>
        <Icon name="bag" />
        <span class="hdr__txt" aria-hidden="true">Bolsa</span>
        <span class="hdr__count" data-bag-count data-empty aria-hidden="true">0</span>
      </button>
      <button class="hdr__btn hdr__menu" type="button" data-open="menu" aria-haspopup="dialog" aria-controls="menu" aria-label="Abrir menú">
        <Icon name="menu" />
      </button>
    </div>
  </div>
</header>
