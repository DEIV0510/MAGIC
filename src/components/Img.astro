---
// <picture> con AVIF + WebP. Los anchos del srcset salen del archivo generado
// (media.json), nunca de lo pedido, así el navegador elige bien.
// data-bg permite al CSS decidir: fondo blanco → entera y fundida con el papel;
// foto de ambiente/showroom → cubre el marco usando su punto focal.
import type { HTMLAttributes } from 'astro/types';
import { pictureData, type MediaId } from '@/lib/media';

interface Props extends Omit<HTMLAttributes<'img'>, 'src' | 'srcset' | 'width' | 'height' | 'id'> {
  id: MediaId;
  alt: string;
  sizes: string;
  priority?: boolean;
  domId?: string;
}

const { id, alt, sizes, priority = false, loading = 'lazy', domId, style, ...rest } = Astro.props;
const d = pictureData(id);
const focus = `--focus:${d.focus}`;
---

<picture>
  <source type="image/avif" srcset={d.avif} sizes={sizes} />
  <source type="image/webp" srcset={d.webp} sizes={sizes} />
  <img
    id={domId}
    src={d.src}
    width={d.width}
    height={d.height}
    alt={alt}
    loading={priority ? 'eager' : loading}
    decoding="async"
    fetchpriority={priority ? 'high' : undefined}
    data-bg={d.bg}
    style={style ? `${focus};${style}` : focus}
    {...rest}
  />
</picture>
