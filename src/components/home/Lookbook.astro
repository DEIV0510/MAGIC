---
// Colección destacada: tira horizontal. En escritorio se fija y avanza con el
// scroll vertical; en móvil (o con movimiento reducido) se desliza con el dedo.
import { bySlug, collectionPalette, pad2, priceLabel, productUrl, swatchStyle } from '@/data/products';
import type { MediaId } from '@/lib/media';
import Img from '@/components/Img.astro';
import Icon from '@/components/Icon.astro';

const looks: { slug: string; color: string; image: MediaId; form: 'tall' | 'low' | 'high' }[] = [
  { slug: 'chaqueton-dama', color: 'gris', image: 'chaqueton-gris-look', form: 'tall' },
  { slug: 'hoodie-hombre', color: 'azul-oscuro', image: 'hoodie-azul-oscuro', form: 'low' },
  { slug: 'chaqueta-nature-flow', color: 'lila', image: 'nature-flow-lila', form: 'tall' },
  { slug: 'chaqueta-ufc-combinada', color: 'negro', image: 'ufc-negro', form: 'high' },
  { slug: 'abrigo-fleece-mujer', color: 'lila', image: 'fleece-lila', form: 'tall' },
  { slug: 'chaqueta-moda-casual', color: 'gris-oscuro', image: 'casual-gris-oscuro-look', form: 'low' },
  { slug: 'buzo-fit-hombre', color: 'azul', image: 'fit-azul', form: 'high' },
  { slug: 'chaqueta-tipo-camisa-dama', color: 'camel', image: 'tipo-camisa-camel', form: 'tall' },
];

const items = looks.map((l) => {
  const p = bySlug(l.slug)!;
  const c = p.colors.find((x) => x.id === l.color)!;
  const img = c.images.find((i) => i.id === l.image)!;
  return { ...l, name: p.name, colorLabel: c.label, view: img.view, price: priceLabel(p), href: productUrl(p, c) };
});
---

<section class="lookbook" id="coleccion" data-lookbook aria-labelledby="lookbook-title">
  <div class="lookbook__pin">
    <div class="lookbook__intro">
      <p class="t-label t-mute">Colección 01</p>
      <h2 class="lookbook__title t-display" id="lookbook-title" data-reveal="lines">
        <span class="ln"><span>Chaquetas</span></span>
        <span class="ln" style="--l:1"><span>y buzos.</span></span>
      </h2>
      <p class="lookbook__text">Para él y para ella. Tela premium y envío incluido en todas las prendas.</p>
      <div class="palette">
        <ul class="palette__dots" aria-label="Colores de la colección">
          {collectionPalette.map((c) => <li style={swatchStyle(c)} title={c.label}><span class="sr-only">{c.label}</span></li>)}
        </ul>
        <p class="t-label t-mute">{collectionPalette.length} colores</p>
      </div>
      <p class="lookbook__hint t-label">
        <span data-hint-touch>Desliza</span>
        <span class="lookbook__ico" aria-hidden="true"><Icon name="arrow" /></span>
      </p>
    </div>

    <div class="lookbook__track" data-lookbook-track>
      {
        items.map((it, i) => (
          <a class:list={['look', `look--${it.form}`]} href={it.href}>
            <span class="look__frame frame">
              <Img
                id={it.image}
                alt={`${it.name} en color ${it.colorLabel.toLowerCase()}, ${it.view}`}
                sizes="(min-width: 1024px) 34vw, (min-width: 768px) 48vw, 72vw"
                loading={i < 3 ? 'eager' : 'lazy'}
                fetchpriority="low"
                draggable="false"
              />
            </span>
            <span class="look__cap">
              <span class="t-index">{pad2(i + 1)}</span>
              <span class="look__name">
                {it.name}
                <small>
                  {it.colorLabel} · {it.price}
                </small>
              </span>
              <Icon name="arrow-ur" />
            </span>
          </a>
        ))
      }

      <div class="look look--end">
        <p>
          Toda la
          <br />
          colección
        </p>
        <a class="btn" href="/coleccion/">
          <span class="roll"><span>Ver colección</span><span aria-hidden="true">Ver colección</span></span>
        </a>
      </div>
    </div>

    <div class="lookbook__progress t-label" aria-hidden="true">
      <span>01</span>
      <span class="lookbook__bar"></span>
      <span>{pad2(items.length)}</span>
    </div>
  </div>
</section>
