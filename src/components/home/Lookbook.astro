---
// Colección destacada: tira horizontal. En escritorio se fija y avanza con el
// scroll vertical; en móvil (o con movimiento reducido) se desliza con el dedo.
import { bySlug, collectionPalette, pad2 } from '@/data/products';
import type { MediaId } from '@/lib/media';
import { getMedia } from '@/lib/media';
import Img from '@/components/Img.astro';
import Icon from '@/components/Icon.astro';

const looks: { slug: string; color: string; image: MediaId; form: 'tall' | 'low' | 'high' }[] = [
  { slug: 'chaqueton-dama', color: 'negro', image: 'chaqueton-negro-cuello', form: 'tall' },
  { slug: 'chaqueta-deportiva-tactica', color: 'rojo', image: 'tactica-rojo-abierta', form: 'low' },
  { slug: 'hoodie-hombre', color: 'gris-carbon', image: 'hoodie-hombre-gris-frente', form: 'tall' },
  { slug: 'chaqueta-moda-casual', color: 'rojo', image: 'casual-rojo-espalda', form: 'high' },
  { slug: 'buzo-largo-dama', color: 'negro', image: 'buzo-largo-negro-frente', form: 'tall' },
  { slug: 'chaqueta-moda-casual', color: 'azul-marino', image: 'casual-azul-lado', form: 'low' },
];

const items = looks.map((l) => {
  const p = bySlug(l.slug)!;
  const c = p.colors.find((x) => x.id === l.color)!;
  const img = c.images.find((i) => i.id === l.image)!;
  return {
    ...l,
    name: p.name,
    colorLabel: c.label,
    view: img.view,
    href: c.id === p.colors[0].id ? `/producto/${p.slug}/` : `/producto/${p.slug}/?color=${c.id}`,
    studio: getMedia(l.image).bg === 'studio',
  };
});
---

<section class="lookbook" id="coleccion" data-lookbook aria-labelledby="lookbook-title">
  <div class="lookbook__pin">
    <div class="lookbook__track" data-lookbook-track>
      <div class="look look__intro">
        <p class="t-label t-mute">Colección 01</p>
        <h2 class="lookbook__title t-display" id="lookbook-title" data-reveal="lines">
          <span class="ln"><span>Chaquetas</span></span>
          <span class="ln" style="--l:1"><span>y buzos.</span></span>
        </h2>
        <p class="lookbook__text">Para él y para ella. Tela premium en cuatro colores.</p>
        <ul class="palette" aria-label="Colores de la colección">
          {collectionPalette.map((c) => <li style={`--sw:${c.swatch}`}>{c.label}</li>)}
        </ul>
        <p class="lookbook__hint t-label">
          <span data-hint-touch>Desliza</span>
          <Icon name="arrow" />
        </p>
      </div>

      {
        items.map((it, i) => (
          <a class:list={['look', `look--${it.form}`]} href={it.href}>
            <span class:list={['look__frame', it.studio ? 'look__frame--studio' : 'on-paper']}>
              <Img
                id={it.image}
                alt={`${it.name} en color ${it.colorLabel.toLowerCase()}, ${it.view}`}
                sizes="(min-width: 1024px) 34vw, (min-width: 768px) 48vw, 78vw"
                loading={i < 2 ? 'eager' : 'lazy'}
                fetchpriority="low"
                draggable="false"
              />
            </span>
            <span class="look__cap">
              <span class="t-index">{pad2(i + 1)}</span>
              <span class="look__name">
                {it.name}
                <small>{it.colorLabel}</small>
              </span>
              <Icon name="arrow-ur" />
            </span>
          </a>
        ))
      }

      <div class="look look--end">
        <p>Toda la<br />colección</p>
        <a class="btn" href="/coleccion/">
          <span class="roll"><span>Ver colección</span><span aria-hidden="true">Ver colección</span></span>
        </a>
      </div>
    </div>

    <div class="lookbook__progress t-label" aria-hidden="true">
      <span>01</span>
      <span class="lookbook__bar"></span>
      <span>{pad2(items.length)}</span>
    </div>
  </div>
</section>
