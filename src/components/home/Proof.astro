---
// Beneficios SOLO con lo que se puede comprobar: envío incluido, telas y tallas
// (información del cliente), hombre/mujer (catálogo), la bodega real (1.png y 2.png)
// y el video real del buzo fit con la etiqueta MAGIC WORLD.
import Img from '@/components/Img.astro';
import ProductVideo from '@/components/ProductVideo.astro';

const items = [
  { t: 'Envío incluido', d: 'El precio de cada prenda ya lo incluye.' },
  { t: 'Tela premium', d: 'Algodón perchado Mónaco, bisonte ovejero y nailon impermeable.' },
  { t: 'Tallas S a XXL', d: 'En la mayoría de prendas; cada ficha muestra las suyas.' },
  { t: 'Hombre / Mujer', d: 'Chaquetas, buzos y abrigos para los dos.' },
];
---

<section class="proof" aria-labelledby="proof-title">
  <h2 class="proof__title t-display" id="proof-title" data-reveal="lines">
    <span class="ln"><span>Sin trucos.</span></span>
  </h2>
  <ul class="proof__list">
    {
      items.map((it, i) => (
        <li class="proof__item" data-reveal style={`--i:${i}`}>
          <span class="t-index">{String(i + 1).padStart(2, '0')}</span>
          <h3>{it.t}</h3>
          <p>{it.d}</p>
        </li>
      ))
    }
  </ul>
  <ProductVideo class="proof__video" label="Buzo fit en gris: etiqueta MAGIC WORLD, cierre y elasticidad de la tela" caption="Buzo fit · tela Zurich, sin filtros" />
  <div class="proof__docs">
    <figure data-reveal="mask">
      <Img id="bodega-1" alt="Estantería de la bodega de MAGIC WORLD con buzos empacados" sizes="(min-width: 1024px) 16vw, 46vw" />
    </figure>
    <figure data-reveal="mask" style="--i:1">
      <Img id="bodega-2" alt="Bodega de MAGIC WORLD con chaquetas y buzos empacados en estantes" sizes="(min-width: 1024px) 16vw, 46vw" />
    </figure>
    <p class="proof__docs-cap t-label">
      <span>Nuestra bodega</span>
      <span>Stock propio</span>
    </p>
  </div>
</section>
