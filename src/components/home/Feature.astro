---
// Producto destacado: el chaquetón delante de su nombre gigante en rojo.
// La foto (fondo blanco) se funde por multiply: la prenda tapa las letras.
// Los rótulos señalan detalles VISIBLES en la foto.
import { bySlug, altFor, pad2 } from '@/data/products';
import { thumbUrl, getMedia } from '@/lib/media';
import { productMessage, waLink } from '@/lib/whatsapp';
import Img from '@/components/Img.astro';
import Icon from '@/components/Icon.astro';

const p = bySlug('chaqueton-dama')!;
const c = p.colors[0];
const img = c.images[0];
const callouts = [
  { label: 'Capucha amplia', x: 47, y: 8, at: 0.2 },
  { label: 'Hebilla metálica', x: 56, y: 40, at: 0.32 },
  { label: 'Cierre asimétrico', x: 38, y: 55, at: 0.44 },
  { label: 'Largo bajo la cadera', x: 61, y: 93, at: 0.56 },
];
---

<section class="feature" data-feature data-progress="pin" aria-labelledby="feature-title">
  <div class="feature__pin">
    <p class="feature__kicker t-label">
      <span>Producto destacado</span>
      <span class="t-index">{pad2(p.priority!)}</span>
    </p>

    <p class="feature__word" aria-hidden="true">Chaquetón</p>

    <div class="feature__stage">
      <figure class="feature__figure">
        <Img id="chaqueton-negro-frente-cut" alt={altFor(p, c, img)} sizes="(min-width: 1024px) 44vw, 90vw" />
        {
          callouts.map((k) => (
            <span class="callout" style={`--x:${k.x}%;--y:${k.y}%;--at:${k.at}`} aria-hidden="true">
              <span class="callout__line" />
              <span class="callout__label">{k.label}</span>
            </span>
          ))
        }
      </figure>
    </div>

    <div class="feature__buy">
      <h2 class="feature__name t-display" id="feature-title">Chaquetón<br />para dama</h2>
      <p class="feature__price">
        Precio por WhatsApp
        <small>Negro · Tela premium</small>
      </p>
      <p class="sr-only">Detalles: {callouts.map((k) => k.label).join(', ')}.</p>
      <div class="feature__ctas">
        <button
          class="btn"
          type="button"
          data-add
          data-open-bag
          data-slug={p.slug}
          data-name={p.name}
          data-color={c.id}
          data-color-label={c.label}
          data-image={thumbUrl(img.id)}
          data-bg={getMedia(img.id).bg}
          data-variant={p.shopifyVariants?.[c.id] ?? ''}
        >
          <span class="roll"><span>Comprar ahora</span><span aria-hidden="true">Comprar ahora</span></span>
        </button>
        <a class="btn btn--ghost" href={waLink(productMessage(p.name, c.label))} target="_blank" rel="noopener">
          <Icon name="whatsapp" />
          <span class="roll"><span>Quiero esta prenda</span><span aria-hidden="true">Quiero esta prenda</span></span>
        </a>
      </div>
      <a class="link" href={`/producto/${p.slug}/`}>Ver detalles <Icon name="arrow" /></a>
    </div>
  </div>
</section>
