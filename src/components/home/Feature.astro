---
// Producto destacado: el chaquetón delante de su nombre gigante en rojo.
// Se usa el recorte con alfa (scripts/cutout.mjs): la prenda tapa las letras.
// Los rótulos señalan detalles VISIBLES en la foto (coordenadas medidas sobre ella).
import { bySlug, altFor, formatPrice, pad2, productUrl } from '@/data/products';
import { productMessage, waLink } from '@/lib/whatsapp';
import Img from '@/components/Img.astro';
import Icon from '@/components/Icon.astro';

const p = bySlug('chaqueton-dama')!;
const c = p.colors.find((x) => x.id === 'negro')!;
const img = c.images[0];
const callouts = [
  { label: 'Capucha con cordón', x: 42, y: 34, at: 0.2 },
  { label: 'Cierre asimétrico', x: 58.5, y: 46, at: 0.32 },
  { label: 'Bolsillos laterales', x: 64.5, y: 63, at: 0.44 },
  { label: 'Bajo cruzado', x: 55, y: 86, at: 0.56 },
];
---

<section class="feature" data-feature data-progress="pin" aria-labelledby="feature-title">
  <div class="feature__pin">
    <p class="feature__kicker t-label">
      <span>Producto destacado</span>
      <span class="t-index">{pad2(p.priority!)}</span>
    </p>

    <p class="feature__word" aria-hidden="true">Chaquetón</p>

    <div class="feature__stage">
      <figure class="feature__figure">
        <Img id="chaqueton-negro-estudio-cut" alt={altFor(p, c, img)} sizes="(min-width: 1024px) 44vw, 90vw" />
        {
          callouts.map((k) => (
            <span class="callout" style={`--x:${k.x}%;--y:${k.y}%;--at:${k.at}`} aria-hidden="true">
              <span class="callout__line" />
              <span class="callout__label">{k.label}</span>
            </span>
          ))
        }
      </figure>
    </div>

    <div class="feature__buy">
      <h2 class="feature__name t-display" id="feature-title">Chaquetón<br />para dama</h2>
      <p class="feature__price">
        {formatPrice(p.price!)}
        <small>Envío incluido · Gris y negro · Tallas S a XXL</small>
      </p>
      <p class="sr-only">Detalles: {callouts.map((k) => k.label).join(', ')}.</p>
      <div class="feature__ctas">
        <button class="btn" type="button" data-quick={p.slug} data-quick-color={c.id} data-quick-intent="buy">
          <span class="roll"><span>Comprar ahora</span><span aria-hidden="true">Comprar ahora</span></span>
        </button>
        <a class="btn btn--ghost" href={waLink(productMessage(p.name, c.label, p.price))} target="_blank" rel="noopener">
          <Icon name="whatsapp" />
          <span class="roll"><span>Quiero esta prenda</span><span aria-hidden="true">Quiero esta prenda</span></span>
        </a>
      </div>
      <a class="link" href={productUrl(p, c)}>Ver detalles <Icon name="arrow" /></a>
    </div>
  </div>
</section>
