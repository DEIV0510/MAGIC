---
// Bolsa, vista rápida, buscador y menú móvil: <dialog> nativo (foco atrapado,
// Escape, fondo inerte). El contenido dinámico sale de #shop-data (Base.astro).
import { nav, site } from '@/data/site';
import { collections } from '@/data/products';
import { waLink, generalMessage } from '@/lib/whatsapp';
import Wordmark from './Wordmark.astro';
import Icon from './Icon.astro';

const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : !href.includes('#') && path.startsWith(href));
const quick = collections.filter((c) => c.slug !== 'coleccion');
const homeLabel = `${site.name}, ir al inicio`;
---

<!-- Bolsa -->
<dialog class="sheet bag" id="bag" aria-labelledby="bag-title">
  <div class="sheet__scrim" data-close aria-hidden="true"></div>
  <div class="bag__panel" data-tone="light">
    <div class="bag__head">
      <h2 class="bag__title" id="bag-title">Bolsa <span data-bag-title-count></span></h2>
      <button class="sheet__close" type="button" data-close aria-label="Cerrar bolsa">
        <Icon name="close" />
      </button>
    </div>
    <div class="bag__body" data-lenis-prevent>
      <ul class="bag__lines" data-bag-lines aria-live="polite"></ul>
      <div class="bag__empty" data-bag-empty hidden>
        <p>Tu bolsa está vacía.</p>
        <a class="btn" href="/coleccion/" data-close-nav>
          <span class="roll"><span>Ver colección</span><span aria-hidden="true">Ver colección</span></span>
        </a>
      </div>
    </div>
    <div class="bag__foot" data-bag-foot>
      <div class="bag__total">
        <span>Total</span>
        <span data-bag-total>—</span>
      </div>
      <p class="bag__note" data-bag-note>Envío incluido. Confirmamos tu pedido por WhatsApp.</p>
      <button class="btn btn--block" type="button" data-checkout>
        <Icon name="whatsapp" />
        <span class="roll"><span>Finalizar pedido</span><span aria-hidden="true">Finalizar pedido</span></span>
      </button>
      <button class="btn btn--ghost btn--block" type="button" data-close>
        <span class="roll"><span>Seguir comprando</span><span aria-hidden="true">Seguir comprando</span></span>
      </button>
    </div>
  </div>
</dialog>

<!-- Vista rápida: color + talla antes de ir a la bolsa -->
<dialog class="sheet quick" id="quick" aria-labelledby="quick-title">
  <div class="sheet__scrim" data-close aria-hidden="true"></div>
  <div class="quick__panel" data-tone="light">
    <div class="quick__head">
      <p class="t-label">Elige tu talla</p>
      <button class="sheet__close" type="button" data-close aria-label="Cerrar">
        <Icon name="close" />
      </button>
    </div>
    <form class="quick__body" data-quick-form novalidate>
      <div class="quick__product">
        <span class="quick__thumb frame"><img data-quick-img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" width="96" height="120" /></span>
        <div>
          <h2 class="quick__name" id="quick-title" data-quick-name></h2>
          <p class="quick__price"><span data-quick-price></span> <small data-quick-ship>Envío incluido</small></p>
        </div>
      </div>

      <fieldset class="opt" data-quick-colors-field>
        <legend class="opt__legend">Color: <strong data-quick-color-name></strong></legend>
        <div class="opt__row" data-quick-colors></div>
      </fieldset>

      <fieldset class="opt" data-quick-sizes-field>
        <legend class="opt__legend">Talla</legend>
        <div class="opt__row" data-quick-sizes></div>
        <p class="opt__error" data-quick-error role="alert" hidden>Elige una talla.</p>
      </fieldset>
      <p class="quick__note t-mute" data-quick-nosize hidden>Te asesoramos con la talla por WhatsApp.</p>

      <button class="btn btn--block" type="submit" data-quick-submit>
        <span class="roll"><span>Agregar a la bolsa</span><span aria-hidden="true">Agregar a la bolsa</span></span>
      </button>
      <a class="link quick__more" href="/" data-quick-link data-close-nav>Ver detalles <Icon name="arrow" /></a>
    </form>
  </div>
</dialog>

<!-- Buscador -->
<dialog class="sheet search" id="search" aria-label="Buscar en la colección">
  <div class="sheet__scrim" data-close aria-hidden="true"></div>
  <div class="search__panel" data-tone="light">
    <form class="search__form" role="search" data-search-form>
      <Icon name="search" />
      <label class="sr-only" for="search-input">Buscar prendas</label>
      <input
        class="search__input"
        id="search-input"
        type="search"
        name="q"
        placeholder="Chaqueta, hoodie, lila…"
        autocomplete="off"
        spellcheck="false"
        enterkeyhint="search"
        data-search-input
      />
      <button class="sheet__close" type="button" data-close aria-label="Cerrar buscador">
        <Icon name="close" />
      </button>
    </form>
    <div class="search__body" data-lenis-prevent>
      <p class="search__status t-label t-mute" data-search-status aria-live="polite">Categorías</p>
      <div class="search__hint" data-search-hint>
        {quick.map((c) => <a href={c.path}>{c.title}</a>)}
        <a href="/coleccion/">Toda la colección</a>
      </div>
      <ul class="search__results" data-search-results></ul>
      <div class="search__empty" data-search-empty hidden>
        <p>No encontramos esa prenda en la colección.</p>
        <a class="link" href={waLink(generalMessage())} target="_blank" rel="noopener">Pregúntanos por WhatsApp <Icon name="arrow" /></a>
      </div>
    </div>
  </div>
</dialog>

<!-- Menú móvil -->
<dialog class="sheet menu" id="menu" aria-label="Menú">
  <div class="menu__panel" data-tone="dark">
    <div class="menu__top">
      <a class="hdr__logo" href="/" aria-label={homeLabel}><Wordmark /></a>
      <button class="sheet__close" type="button" data-close aria-label="Cerrar menú">
        <Icon name="close" />
      </button>
    </div>
    <nav aria-label="Menú principal" style="flex:1;display:flex">
      <ol class="menu__list">
        {
          nav.map((item, i) => (
            <li style={`--i:${i}`}>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined} data-close-nav>
                <span class="t-index">{String(i + 1).padStart(2, '0')}</span>
                <span class="menu__word">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
    <div class="menu__foot">
      <a class="btn btn--red btn--block" href={waLink(generalMessage())} target="_blank" rel="noopener">
        <Icon name="whatsapp" />
        <span>Pedir por WhatsApp</span>
      </a>
      <p>WhatsApp {site.whatsapp.display}</p>
    </div>
  </div>
</dialog>
